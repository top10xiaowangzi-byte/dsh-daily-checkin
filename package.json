{
  "name": "dsh-daily-checkin",
  "displayName": "DSH Daily Check-in (WorkBuddy / 灵犀 / Qoder / MiniMax / 码道)",
  "version": "1.4.0",
  "description": "DSH 启动时自动完成 WorkBuddy、WPS 灵犀、Qoder、MiniMax Code 与码道 CodeArts 的每日签到/领取积分，并在会话标题栏显示签到结果面板（失败可重试）。",
  "keywords": ["dsh-plugin", "deepseek-harness", "daily-checkin", "lingxi", "wps", "qoder", "minimax", "minimax-code", "codearts", "huaweicloud", "workbuddy"],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cookies-helper.mjs",
    "codearts-browser-common.mjs",
    "codearts-claim.mjs",
    "codearts-login.mjs",
    "码道登录.cmd",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["slots"]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
